# Copy this file to .env (workspace root) and fill in real values.
# NEVER commit the real .env — it is git-ignored.

# OpenRouter gateway API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default model for LLM smoke tests during deploy
OPENROUTER_MODEL=qwen/qwen3.7-flash
